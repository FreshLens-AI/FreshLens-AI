# Copy to .env and fill in values. Never commit .env.

# PostgreSQL for an API process running directly on the host. The local login is
# development-only, has no elevated privileges, and is subject to RLS.
DATABASE_URL=postgresql://freshlens_api_local:freshlens_api_local@localhost:5432/freshlens
DATABASE_SSL_MODE=prefer

# Optional Docker API override. Leave empty for local Compose; set this to a
# restricted Supabase session-pooler URI (with TLS) when testing the hosted DB.
COMPOSE_DATABASE_URL=
COMPOSE_DATABASE_SSL_MODE=disable

# Supabase (hosted PostgreSQL + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only and currently not required by the auth flow. Never expose it to a
# NEXT_PUBLIC_* or EXPO_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_CLOCK_SKEW_SECONDS=30

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local scan image volume (opaque image_path). Prod R2 is #18.
SCAN_STORAGE_DIR=./data/scans

# Worker classifier: identity-v1 (four-product identity + freshness-v1) or stub.
CLASSIFIER=identity-v1
IDENTITY_WEIGHTS=/app/models/identity-v1.pt
IDENTITY_MODEL_VERSION=identity-yolo26n-cls-v1
IDENTITY_IMAGE_SIZE=160
IDENTITY_MIN_CONFIDENCE=0.75
FRESHNESS_WEIGHTS=/app/models/freshness-v1.pt
FRESHNESS_MODEL_VERSION=freshness-yolo26n-cls-v1
FRESHNESS_IMAGE_SIZE=224
FRESHNESS_MIN_CONFIDENCE=0.50

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freshlens-scans
R2_PUBLIC_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
