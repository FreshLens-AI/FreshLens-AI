{
  "expo": {
    "name": "FreshLens",
    "slug": "mobile",
    "scheme": "freshlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FreshLens needs camera access to scan produce freshness.",
        "NSMicrophoneUsageDescription": "FreshLens uses the microphone so you can record sales by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sathurshnau.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FreshLens uses the microphone so you can record sales by voice.",
          "speechRecognitionPermission": "FreshLens converts your speech to text to draft sales.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FreshLens needs camera access to scan produce freshness."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0d3427",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1397c863-eefb-4271-ae36-d0f4cb93a6ee"
      }
    }
  }
}
