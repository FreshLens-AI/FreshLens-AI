{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "env:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "prestart": "npm run env:check",
    "start": "expo start",
    "preandroid": "npm run env:check",
    "android": "expo start --android",
    "preios": "npm run env:check",
    "ios": "expo start --ios",
    "preweb": "npm run env:check",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/auth/*.test.ts"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.12",
    "expo-camera": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "private": true
}