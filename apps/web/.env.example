NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Public API base for browsers/mobile. In production this is the Vercel app
# itself so /api/v1/* is rewritten to the FastAPI upstream.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Direct FastAPI origin used by next.config rewrites and server-side admin fetches.
# Production example: http://172.198.64.148:8000
API_UPSTREAM_URL=http://localhost:8000
